{
 "title": "dnsdir \u2014 overview",
 "uid": "dnsdir-overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "dnsdir"
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   },
   {
    "name": "instance",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(dnsdir_info, instance)",
     "refId": "q"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Open alerts (not acknowledged or silenced)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(dnsdir_alerts_active{instance=~\"$instance\"})",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Open alerts by severity",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 5,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (severity) (dnsdir_alerts_active{instance=~\"$instance\"})",
     "legendFormat": "{{severity}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Queries per second",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dnsdir_dns_queries_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "SERVFAIL share",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dnsdir_dns_servfail_total{instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(dnsdir_dns_queries_total{instance=~\"$instance\"}[5m])), 1)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Upstream servers down",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(dnsdir_upstream_healthy{instance=~\"$instance\"} == 0) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Active gateways",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(dnsdir_gateway_active{instance=~\"$instance\"})",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Queries per second by node",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(dnsdir_dns_queries_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Answered, SERVFAIL and turned away (per second)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dnsdir_dns_answered_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "answered",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum(rate(dnsdir_dns_servfail_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "SERVFAIL",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "C",
     "expr": "sum(rate(dnsdir_dns_denied_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "not allowed",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "D",
     "expr": "sum(rate(dnsdir_dns_client_limited_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "client limit",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "E",
     "expr": "sum(rate(dnsdir_dns_domain_limited_total{instance=~\"$instance\"}[5m]))",
     "legendFormat": "domain limit",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Cache hit share",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 17
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (rate(dnsdir_cache_hits_total{instance=~\"$instance\"}[5m])) / clamp_min(sum by (instance) (rate(dnsdir_cache_hits_total{instance=~\"$instance\"}[5m]) + rate(dnsdir_cache_misses_total{instance=~\"$instance\"}[5m])), 1)",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Answers in the cache",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 17
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (dnsdir_cache_entries{instance=~\"$instance\"})",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Upstream answer time",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_upstream_latency_ms{instance=~\"$instance\"}",
     "legendFormat": "{{instance}} {{server}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "table",
   "title": "Upstream health (1 = up)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_upstream_healthy{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "table",
   "title": "Gateway active (1 = this node holds the group)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 0,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_gateway_active{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 14,
   "type": "table",
   "title": "Gateway DNS listener up",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 6,
    "w": 12,
    "x": 12,
    "y": 33
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_gateway_dns_listening{instance=~\"$instance\"}",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 15,
   "type": "table",
   "title": "Certificate days left",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 6,
    "w": 24,
    "x": 0,
    "y": 39
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_certificate_expires_in_seconds{instance=~\"$instance\"} / 86400",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "format": "table",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "CPU in use",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 45
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_host_cpu_percent{instance=~\"$instance\"}",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Memory in use",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 45
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_host_memory_used_bytes{instance=~\"$instance\"} / dnsdir_host_memory_total_bytes{instance=~\"$instance\"}",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Load (1 minute)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 45
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_host_load{minutes=\"1\",instance=~\"$instance\"}",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Filesystems in use",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 53
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dnsdir_host_filesystem_used_percent{instance=~\"$instance\"}",
     "legendFormat": "{{instance}} {{mount}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Network traffic",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 53
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (dnsdir_host_interface_receive_bits_per_second{instance=~\"$instance\"})",
     "legendFormat": "{{instance}} in",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (instance) (dnsdir_host_interface_transmit_bits_per_second{instance=~\"$instance\"})",
     "legendFormat": "{{instance}} out",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {}
  }
 ],
 "annotations": {
  "list": []
 }
}